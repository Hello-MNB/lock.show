{
  "name": "gigproof",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"node server/index.js\"",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "build:embed": "vite build --mode embed && node scripts/embed-post.mjs",
    "preview": "vite preview",
    "seed": "node scripts/seed.mjs",
    "lint:i18n": "node scripts/i18n-purity.mjs",
    "test:nav": "node scripts/nav-contract.test.mjs",
    "test:isolation": "node scripts/test-act-isolation.mjs",
    "test:canon": "node scripts/test-canon-drift.mjs",
    "test:security": "node scripts/test-security-denial.mjs",
    "test:guardrails": "node scripts/test-guardrails.mjs",
    "test:ds": "node scripts/test-ds-drift.mjs",
    "test:states": "node scripts/test-widget-states.mjs",
    "test:one-truth": "node scripts/test-one-truth.mjs",
    "check:styles": "node scripts/generate-component-styles.mjs --check",
    "validate:registry": "node scripts/validate-registry.mjs",
    "validate:deltas": "node scripts/validate-deltas.mjs",
    "registry:events": "node scripts/generate-event-registry.mjs",
    "verify": "npm run test:nav && npm run test:isolation && npm run test:canon && npm run test:analytics && npm run test:security && npm run test:guardrails && npm run test:ds && npm run test:states && npm run test:one-truth && npm run test:embed && npm run test:seo && npm run test:sitenav && npm run test:hero && npm run test:visual && npm run check:styles && npm run lint:i18n && npm run validate:registry && npm run validate:deltas && node scripts/generate-event-registry.mjs --check && npm run build && npm run build:demo && npm run test:fit",
    "test:fit": "node scripts/test-fit.mjs",
    "test:embed": "node scripts/test-embed-integrity.mjs",
    "test:seo": "node scripts/test-seo-contract.mjs",
    "test:analytics": "node scripts/test-analytics-contract.mjs",
    "test:sitenav": "node scripts/test-site-nav.mjs",
    "test:hero": "node scripts/test-hero-contract.mjs",
    "test:visual": "node scripts/test-visual-regression.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@fontsource/frank-ruhl-libre": "^5.2.8",
    "@fontsource/heebo": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "playwright": "^1.61.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^1.3.0"
  }
}