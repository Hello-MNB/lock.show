# ─────────────────────────────────────────────────────────────
# GIGPROOF — local environment. Copy this file to ".env.local"
# and fill in the values. .env.local is git-ignored (never committed).
# ─────────────────────────────────────────────────────────────

# ── Supabase (free cloud project: https://supabase.com → New project) ──
# Project Settings → API → Project URL  and  anon/public key
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Server-side only (used by server/index.js, NEVER exposed to browser) ──
# Supabase service_role key (Project Settings → API). Lets the AI server
# write Claim records past RLS. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Anthropic (Claude) — for AI evidence→claim processing ──
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Model used for claim extraction/labelling
ANTHROPIC_MODEL=claude-opus-4-8

# Local AI/api server port (must match vite proxy)
API_PORT=8787

# ── Gate email (§14.6.5) — DARK BY DEFAULT (rule 11: never sends in dev/test) ──
# The availability-request ("someone asked about your date") email to the artist
# sends ONLY when BOTH are set: EMAIL_ENABLED=1 AND a real RESEND_API_KEY.
# Leave EMAIL_ENABLED unset/0 everywhere until the owner flips it in production.
EMAIL_ENABLED=0
# Resend API key (https://resend.com) — server-side only, never exposed to browser.
RESEND_API_KEY=
# Optional FROM override. Default in code: 'LOCK <hello@lock.show>' (brief W3-5);
# spec §14.6.5 authors 'LOCK <notifications@lock.show>' — set EMAIL_FROM to the
# owner-confirmed address at wiring time.
EMAIL_FROM=

# ── Social login (Supabase Auth) ──
# CORRECTED 16 Aug 2026 (Lane M): the code default is ON, not off —
# src/lib/constants.js reads `VITE_OAUTH_ENABLED !== '0'`, because the GOOGLE
# provider is enabled in the Supabase dashboard (owner action, 8 Jul 2026).
# This line is therefore a KILL-SWITCH, not an opt-in: set 0 to hide the buttons.
VITE_OAUTH_ENABLED=1
# Facebook is a SEPARATE per-provider flag, default OFF, because the provider is
# NOT enabled in Supabase — showing the button produced a raw provider error.
# Flip to 1 only after a Facebook app exists AND the provider is enabled there.
VITE_OAUTH_FACEBOOK=0

# ── Client feature flags (bundle-visible — never secrets) ──
# Registered in docs/INTEGRATION-CONTRACT-REGISTER.md and enforced by
# `npm run test:integration-contract`. Every flag below defaults SAFE when unset.
# Payments stay dormant until the owner activates them post-Gate (canon G17).
VITE_PAYMENTS_ENABLED=0
# Radar audience split (migration 042 client half): 1 = a representation org
# reads ONLY the bounded rep-summary projection, not the artist's private Radar.
# Default 0 because tightening removes information from a shipped screen.
VITE_RADAR_AUDIENCE_SPLIT=0
# Demo/preview switches used by tests and the offline preview build.
VITE_DEMO=0
VITE_NO_API=0

# ── Server operational knobs (all optional; code defaults shown) ──
# Browser origin allowlist, comma-separated. Unset = production + localhost:5173.
ALLOWED_ORIGINS=
# Per-IP sliding-window request cap, trailing 60s (default 30).
RATE_LIMIT_PER_MIN=30
# Confirmation-token expiry in days (default 14).
CONFIRM_TOKEN_TTL_DAYS=14
# Share-link service toggle.
SHARE_LINK_SERVICE_ENABLED=0
# AI spend guards (defaults: 15 / 15 / $0.02 / $50 hard cap / $25 warn).
MAX_ITEMS_PER_JOB=15
MAX_ITEMS_PER_USER_DAY=15
COST_PER_ITEM_USD=0.02
MONTHLY_BUDGET_USD=50
ALERT_AT=25
